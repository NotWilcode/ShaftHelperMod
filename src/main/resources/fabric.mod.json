		],
		"modmenu": [
			"dev.shafthelper.mod.ModMenuIntegration"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.1",
		"java": ">=25",
		"fabric-api": ">=0.155.0+26.1"
	},
	"mixins": [
		{
		"config": "shafthelper.mixins.json",
